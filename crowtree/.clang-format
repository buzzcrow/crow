---
BasedOnStyle: Google
IndentWidth: 2
ColumnLimit: 100
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"crowtree/'
    Priority: 1
  - Regex: '^<.*\.h>'
    Priority: 2
  - Regex: '^<.*>'
    Priority: 3
BreakBeforeBraces: Custom
BraceWrapping:
  AfterControlStatement: Always
  AfterFunction: false
  AfterClass: false
  AfterStruct: false
