namespace crow.rpc.proto;

// Single dispatch key for the crow-rpc framing layer. The framing header
// carries msg_type as an opaque u16; the handler map dispatches on it.
//
// R104 ships only the common messages (unknown + connection ping). Each
// service owns a numeric range and registers its own message types in its
// own `.fbs` schema (diskio in R105, consensus in R32, etc.) — those
// extend this enum in their own crate, not here. The ranges reserved for
// future services are documented below but NOT enumerated:
//   kv          1000s
//   sys meta    2000s
//   diskdb      3000s
//   chunkdb     3300s
//   disk io     3600s
enum FBMsgType : int16 {
    EUnknownRequest = 0,
    EUnknownResponse = 1,
    EConnectionPingRequest = 2,
    EConnectionPingResponse = 3,
    // diskio service (range 3600s, see diskio.fbs)
    EDiskWriteRequest = 3600,
    EDiskWriteResponse = 3601,
    EDiskReadRequest = 3602,
    EDiskReadResponse = 3603,
    EDiskFsyncRequest = 3604,
    EDiskFsyncResponse = 3605,
    // diskdb service (range 3000s, see diskdb.fbs — R115)
    EAllocateBlocksRequest = 3000,
    EAllocateBlocksResponse = 3001,
    EFreeBlocksRequest = 3002,
    EFreeBlocksResponse = 3003,
    ECommitBlocksRequest = 3004,
    ECommitBlocksResponse = 3005,
    EQueryCapacityStatsRequest = 3006,
    EQueryCapacityStatsResponse = 3007,
    EGetDiskGroupInfoRequest = 3008,
    EGetDiskGroupInfoResponse = 3009,
    EGetDiskInfoRequest = 3010,
    EGetDiskInfoResponse = 3011,
    ERebuildZoneBitmapRequest = 3012,
    ERebuildZoneBitmapResponse = 3013,
    ERecalcDiskUsageRequest = 3014,
    ERecalcDiskUsageResponse = 3015,
    ECompactZoneRequest = 3016,
    ECompactZoneResponse = 3017,
    ETriggerScanRequest = 3018,
    ETriggerScanResponse = 3019,
    EGetScanStatusRequest = 3020,
    EGetScanStatusResponse = 3021,
}
