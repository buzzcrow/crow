#!/bin/bash

echo "Running pre-commit checks..."

# Check Rust formatting
echo "Checking Rust formatting..."
if ! cargo fmt --all -- --check; then
    echo "⚠️  Formatting issues found. Running 'cargo fmt' to fix..."
    cargo fmt --all
    if ! cargo fmt --all -- --check; then
        echo "❌ Formatting still failing after 'cargo fmt'. Fix manually before committing."
        exit 1
    fi
    echo "✅ Formatting auto-fixed. Review and re-stage the changes, then commit again."
    exit 1
fi

# Check C++ formatting
echo "Checking C++ formatting..."
if ! pixi run clang-format --dry-run --Werror crowtree/src/*.cpp crowtree/include/crowtree/*.h 2>/dev/null; then
    echo "⚠️  C++ formatting issues found. Running 'clang-format -i' to fix..."
    pixi run clang-format -i crowtree/src/*.cpp crowtree/include/crowtree/*.h
    echo "✅ C++ formatting auto-fixed. Review and re-stage the changes, then commit again."
    exit 1
fi

# Run clippy (Rust lint)
echo "Running clippy..."
cargo clippy --all-targets -- -D warnings
if [ $? -ne 0 ]; then
    echo "❌ Clippy failed. Fix warnings before committing."
    exit 1
fi

# Run clang-tidy (C++ lint)
echo "Running clang-tidy..."
if [ -d crowtree/build ]; then
    pixi run clang-tidy crowtree/src/*.cpp -p crowtree/build 2>&1
    if [ $? -ne 0 ]; then
        echo "❌ clang-tidy failed. Fix warnings before committing."
        exit 1
    fi
else
    echo "⚠️  Skipping clang-tidy: crowtree/build not found. Run 'pixi run build' first."
fi

echo "✅ All checks passed!"
