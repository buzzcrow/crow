# ── Rust / Cargo ────────────────────────────────────────────────
debug
target
**/*.rs.bk
**/mutants.out*/
tarpaulin-report.html

# ── Pixi ────────────────────────────────────────────────────────
.pixi/

# ── C++ (crow-tree) build artifacts ──────────────────────────────
build/
lib/crow-tree/build/
lib/crow-tree/build-asan/
lib/crow-tree/build-tsan/
lib/crow-tree/build-bench/
lib/crow-tree/build*/
lib/crow-tree/Testing/
lib/crow-tree/.cache/
lib/crow-tree/.test-tmp/
.test-tmp/

# ── Frontend (app/crow-web/ui) ────────────────────────────
app/crow-web/ui/node_modules/
app/crow-web/ui/dist/
app/crow-web/ui/.vite/
app/crow-web/ui/*.tsbuildinfo
app/crow-web/ui/e2e/runtime-data/

# ── Runtime artifacts (WAL, config, logs) ───────────────────────
# Top-level artifact dirs (anchored to repo root).
/log/
/runtime-data/ 
# bench-runs/ holds datetime-stamped run dirs; ignore contents
# but keep the directory itself in the repo.
/bench-runs/*
test-logs/

app/crow-cli/bench-runs/

# Per-crate runtime dirs — these names don't appear in source code,
# so globbing is safe and avoids repeating per crate.
**/waldata/
**/conf/
**/ctdata/

# `log/` is dangerous as a glob — "log" is a common Rust module name.
# List explicitly per crate to avoid ignoring source directories.
app/crow-kv-server/log/
app/crow-cli/log/
lib/crow-console-shared/log/
app/crow-web/log/

# ── Profiling artifacts ─────────────────────────────────────────
# samply / perf / flamegraph output (profile-write-*.zip, profile-write-*/)
doc/working/profile-*
# bench sweep raw output (bench-write-*.tsv, bench-read-*.tsv, etc.)
doc/working/bench-*.tsv
perf.data*
perf-script.txt
flamegraph.svg

# ── IDE / OS ────────────────────────────────────────────────────
.idea/
.DS_Store
