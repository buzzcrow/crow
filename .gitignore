# ── Rust / Cargo ────────────────────────────────────────────────
debug
target
**/*.rs.bk
**/mutants.out*/
tarpaulin-report.html

# ── Pixi ────────────────────────────────────────────────────────
.pixi/

# ── C++ (crowtree) build artifacts ──────────────────────────────
build/
crowtree/build/
crowtree/build-asan/
crowtree/build-tsan/
crowtree/build-bench/
crowtree/build*/
crowtree/Testing/
crowtree/.cache/
crowtree/.test-tmp/

# ── Frontend (crowkv-console/web/ui) ────────────────────────────
crowkv-console/web/ui/node_modules/
crowkv-console/web/ui/dist/
crowkv-console/web/ui/.vite/
crowkv-console/web/ui/*.tsbuildinfo
crowkv-console/web/ui/e2e/runtime-data/

# ── Runtime artifacts (WAL, config, logs) ───────────────────────
# Top-level artifact dirs (anchored to repo root).
/log/
/runtime-data/ 
# bench-runs/ holds datetime-stamped run dirs; ignore contents
# but keep the directory itself in the repo.
/bench-runs/*
test-logs/

crowkv-console/cli/bench-runs/

# Per-crate runtime dirs — these names don't appear in source code,
# so globbing is safe and avoids repeating per crate.
**/waldata/
**/conf/
**/ctdata/

# `log/` is dangerous as a glob — "log" is a common Rust module name.
# List explicitly per crate to avoid ignoring source directories.
crowkv-server/log/
crowkv-console/cli/log/
crowkv-console/shared/log/
crowkv-console/web/log/

# ── Profiling artifacts ─────────────────────────────────────────
# samply / perf / flamegraph output (profile-write-*.zip, profile-write-*/)
doc/working/profile-*
perf.data*
perf-script.txt
flamegraph.svg

# ── IDE / OS ────────────────────────────────────────────────────
.idea/
.DS_Store
