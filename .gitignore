# ── Rust / Cargo ────────────────────────────────────────────────
debug
target
**/*.rs.bk
**/mutants.out*/
tarpaulin-report.html

# ── Pixi ────────────────────────────────────────────────────────
.pixi/

# ── C++ (crowdb-tree) build artifacts ──────────────────────────────
build/
lib/crowdb-tree/build/
lib/crowdb-tree/build-asan/
lib/crowdb-tree/build-tsan/
lib/crowdb-tree/build-bench/
lib/crowdb-tree/build*/
lib/crowdb-tree/Testing/
Testing/
lib/crowdb-tree/.cache/
lib/crowdb-tree/.test-tmp/
.test-tmp/

# ── Frontend (app/crowdb-web/ui) ────────────────────────────
app/crowdb-web/ui/node_modules/
app/crowdb-web/ui/dist/
app/crowdb-web/ui/.vite/
app/crowdb-web/ui/*.tsbuildinfo
app/crowdb-web/ui/e2e/runtime-data/

# ── Runtime artifacts (WAL, config, logs) ───────────────────────
# Top-level artifact dirs (anchored to repo root).
/log/
/runtime-data/ 
# bench-runs/ holds datetime-stamped run dirs; ignore contents
# but keep the directory itself in the repo.
/bench-runs/*
test-logs/

app/crowdb-cli/bench-runs/

# Per-crate runtime dirs — these names don't appear in source code,
# so globbing is safe and avoids repeating per crate.
**/waldata/
**/ctdata/
# Runtime config dirs (operator-supplied real configs, not tracked).
# Tracked default configs live in app/<crate>/conf/*.json.
app/crowdb-diskdb/conf/runtime/
app/crowdb-kv-server/conf/runtime/
lib/crowdb-console-shared/conf/

# `log/` is dangerous as a glob — "log" is a common Rust module name.
# List explicitly per crate to avoid ignoring source directories.
app/crowdb-kv-server/log/
app/crowdb-cli/log/
lib/crowdb-console-shared/log/
app/crowdb-web/log/
app/crowdb-diskdb/log/
app/crowdb-chunkdb/log/
lib/crowdb-diskdb-client/log/
lib/crowdb-diskio-client/log/

# ── Profiling artifacts ─────────────────────────────────────────
# samply / perf / flamegraph output (profile-write-*.zip, profile-write-*/)
doc/working/profile-*
# bench sweep raw output (bench-write-*.tsv, bench-read-*.tsv, etc.)
doc/working/bench-*.tsv
perf.data*
perf-script.txt
flamegraph.svg

# ── IDE / OS ────────────────────────────────────────────────────
.idea/
.DS_Store

# crowdb-rpc build + clangd cache
lib/crowdb-rpc/build/
lib/crowdb-rpc/build-asan/
lib/crowdb-rpc/build-tsan/
lib/crowdb-rpc/build*/
lib/crowdb-rpc/.cache/

# crowdb-diskio build + clangd cache
app/crowdb-diskio/build/
app/crowdb-diskio/build*/
app/crowdb-diskio/.cache/
lib/crowdb-chunk-client/log/
