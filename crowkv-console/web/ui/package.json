{
  "name": "crowkv-console-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CrowKV Console SPA. Built with Vite + React + TypeScript + Tailwind. Compiled output in dist/ is served by crowkv-web (Axum) at runtime.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "reactflow": "^11.10.4",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "chrome-launcher": "^1.2.1",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.8.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.1"
  }
}
